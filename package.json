{
  "name": "owsem-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=docs...",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "size": "turbo run size",
    "lint:pkg": "turbo run lint:pkg",
    "registry:build": "turbo run registry:build",
    "verify": "biome ci . && turbo run build typecheck test size lint:pkg",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.8",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
