{
  "name": "owsem",
  "version": "0.0.0",
  "description": "OwsemUI CLI: init, add, diff, list, tokens",
  "keywords": [
    "owsem-ui",
    "cli",
    "registry",
    "components"
  ],
  "license": "MIT",
  "author": "Alvin A. Rahman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alviinaditya/owsem-ui.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "owsem": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "rm -rf .pack && pnpm pack --pack-destination .pack && publint --strict .pack/*.tgz"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
