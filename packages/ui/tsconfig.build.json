{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Sources are also copied into user projects via the registry: no test types, no .ts imports.
    "allowImportingTsExtensions": false,
    "declaration": true,
    "isolatedDeclarations": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
